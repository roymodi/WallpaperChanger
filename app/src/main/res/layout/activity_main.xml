<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lightweight automatic wallpaper changes"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable automatic schedule"
            android:textSize="17sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:padding="12dp"
            android:background="#11000000"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnRefreshNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change wallpaper now"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule and screen settings"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSelectLocalImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select local Lock Screen images"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local images are used only on the Lock Screen and may repeat. When Both screens is selected, Home always uses an online image."
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
